{
  "name": "vexyo-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.14.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:core": "vitest run packages/core",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "vexyo": "tsx packages/cli/src/index.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.19.0",
    "@vexyo/cli": "workspace:*",
    "@vexyo/core": "workspace:*",
    "@vexyo/reporters": "workspace:*",
    "@types/node": "^22.13.0",
    "eslint": "^9.19.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vitest": "^3.0.5"
  }
}
