{
  "name": "@vexyo/reporters",
  "version": "0.0.0",
  "description": "Console, JSON, JUnit, and Markdown reporters for vexyo MCP test runs.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "testing",
    "conformance",
    "regression",
    "ci",
    "junit",
    "reporter"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vexyohq/vexyo.git",
    "directory": "packages/reporters"
  },
  "homepage": "https://github.com/vexyohq/vexyo#readme",
  "private": false,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "dependencies": {
    "@vexyo/core": "workspace:*"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup"
  }
}
