{
  "name": "@vexyo/cli",
  "version": "0.0.0",
  "description": "CLI for vexyo — conformance and regression testing for MCP servers, for local dev and CI.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "testing",
    "conformance",
    "regression",
    "ci",
    "cli"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vexyohq/vexyo.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/vexyohq/vexyo#readme",
  "private": false,
  "type": "module",
  "bin": {
    "vexyo": "./dist/index.js"
  },
  "exports": {
    ".": {
      "development": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./config": {
      "development": "./src/define.ts",
      "types": "./dist/define.d.ts",
      "default": "./dist/define.js"
    },
    "./api": {
      "development": "./src/api.ts",
      "types": "./dist/api.d.ts",
      "default": "./dist/api.js"
    }
  },
  "dependencies": {
    "@vexyo/core": "workspace:*",
    "@vexyo/reporters": "workspace:*",
    "commander": "^13.1.0",
    "jiti": "^2.4.2",
    "zod": "^4.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./config": {
        "types": "./dist/define.d.ts",
        "default": "./dist/define.js"
      },
      "./api": {
        "types": "./dist/api.d.ts",
        "default": "./dist/api.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "tsup"
  }
}
